<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Inicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/red_045"
    tools:context=".PantallaPrincipal"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/Cuadroarriba"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/red_043"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="20dp"
        >

        <TextView
            android:id="@+id/Bienvenida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Bienvendio \nUsuario"
            android:textColor="@color/orange_008"
            android:textSize="40sp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/CerrarSesion"
            app:layout_constraintTop_toTopOf="@id/Cuadroarriba" />
            />
        <Button
            android:id="@+id/CerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/Cuadroarriba"
            app:layout_constraintTop_toTopOf="@id/Cuadroarriba"
            style="@style/Widget.AppCompat.Button.Colored"
            app:backgroundTint="@color/orange_008"
            android:textColor="@color/red_043"
            android:text="cerrar \n sesion"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ELIGA UNA OPCION"
        android:textSize="40dp"
        app:layout_constraintTop_toBottomOf="@id/Cuadroarriba"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_margin="20dp"
        android:textColor="@color/orange_008"
        />
    <Button
        android:id="@+id/botonTransferir"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="258dp"
        android:layout_height="120dp"
        android:text="Trasferir"
        android:textSize="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Cuadroarriba"
        app:backgroundTint="@color/orange_008"
        android:textColor="@color/red_043"
        android:layout_marginTop="120dp"
        android:layout_marginLeft="20dp"
        />
    <Button
        android:id="@+id/botonverSaldo"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="258dp"
        android:layout_height="120dp"
        android:text="ver saldo"
        android:textSize="30dp"
        app:backgroundTint="@color/orange_008"
        android:textColor="@color/red_043"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botonTransferir"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"/>
    <TextView
        android:id="@+id/Consejos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:backgroundTint="@color/red_043"
        android:textColor="@color/orange_008"
        android:text="Consejo"
        android:textSize="50dp"
        android:textAlignment="center"
        android:layout_marginBottom="40dp"
        android:layout_marginLeft="20dp"
        android:layout_marginEnd="20dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>